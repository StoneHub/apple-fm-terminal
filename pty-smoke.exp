#!/usr/bin/expect -f
set timeout 12
set here [file dirname [file normalize [info script]]]
spawn zsh -dfi
expect "%"
send -- "PS1='PROOF>'; bindkey -e; APPLE_FM_COMMAND='$here/fixture-fm'; source '$here/apple-fm.zsh'; apple-fm-enable\r"
expect "PROOF>"
send -- "bindkey -M emacs '^I'; bindkey -M emacs '^X^F'\r"
expect "apple-fm-tab"
expect "fm-suggest"
send -- {function proof-buffer { zle -M -- "BUFFER:$BUFFER" }; zle -N proof-buffer; bindkey -M emacs '^X^B' proof-buffer\r}
expect "PROOF>"
send -- "alpha"
send -- "\030\006"
expect " suffix"
send -- "\030\002"
expect "BUFFER:alpha"
send -- "\t"
send -- "\030\002"
expect "BUFFER:alpha suffix"
send -- "\033"
expect "PROOF>"
send -- "SLOW"
send -- "\030\006"
after 100
send -- "\033"
after 1300
send -- "x"
send -- "\003"
expect "PROOF>"
send -- {apple-fm-disable; bindkey -M emacs '^I'; bindkey -M emacs '^['; bindkey -M emacs '^X^F'\r}
expect "expand-or-complete"
expect "send-break"
expect "undefined-key"
send -- "exit\r"
expect eof
