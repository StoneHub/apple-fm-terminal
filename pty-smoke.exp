#!/usr/bin/expect -f
set timeout 12
set here [file dirname [file normalize [info script]]]
set env(TERM) xterm-256color
spawn zsh -dfi
# Install the timeout handler after spawn so it applies to the shell PTY, not
# this Expect script's stdin.
expect_after timeout {error "PTY assertion timed out"}
expect "%"
send -- "PS1='PROOF>'; setopt nounset ksharrays; bindkey -e; APPLE_FM_COMMAND='$here/fixture-fm'; APPLE_FM_DEBOUNCE=0.1; source '$here/apple-fm.zsh'\r"
expect "PROOF>"
send -- {saved=$(bindkey -M emacs '^I'; bindkey -M emacs '^['; bindkey -M emacs '^X^F'); function proof-buffer { zle -M -- "STATE:<${BUFFER}>:<${_APPLE_FM_SUGGESTION}>" }; zle -N proof-buffer; bindkey -M emacs '^X^B' proof-buffer; apple-fm-enable; print SETUP_DONE}
send -- "\r"
expect "\r\nSETUP_DONE\r\n"
expect "PROOF>"
send -- {[[ -o nounset && -o ksharrays ]] && print OPTIONS_AFTER_ENABLE}
send -- "\r"
expect "\r\nOPTIONS_AFTER_ENABLE\r\n"
expect "PROOF>"
send -- "alpha"
send -- "\030\006"
expect " suffix"
send -- "\030\002"
expect "STATE:<alpha>:< suffix>"
send -- "\t"
send -- "\030\002"
expect "STATE:<alpha suffix>:<>"
send -- "\003"
expect "PROOF>"
send -- "SLOW"
send -- "\030\006"
after 100
send -- "\033"
after 1500
send -- "\030\002"
expect "STATE:<SLOW>:<>"
send -- "\003"
expect "PROOF>"
send -- {apple-fm-disable; [[ "$saved" == "$(bindkey -M emacs '^I'; bindkey -M emacs '^['; bindkey -M emacs '^X^F')" ]] && print RESTORED; [[ -o nounset && -o ksharrays ]] && print OPTIONS_AFTER_DISABLE; apple-fm-enable; [[ $(bindkey -M emacs '^I') == *apple-fm-tab* ]] && print REENABLED; [[ -o nounset && -o ksharrays ]] && print OPTIONS_AFTER_REENABLE; apple-fm-disable; print -u2 STDERR_ALIVE}
send -- "\r"
expect "\r\nRESTORED\r\n"
expect "OPTIONS_AFTER_DISABLE"
expect "REENABLED"
expect "OPTIONS_AFTER_REENABLE"
expect "STDERR_ALIVE"
expect "PROOF>"
send -- "exit\r"
expect eof
puts "PASS: preview, whitespace, Tab buffer insertion without execution, dismissal, binding restoration, stderr preservation"
