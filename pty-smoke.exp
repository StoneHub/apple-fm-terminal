#!/usr/bin/expect -f
set timeout 12
set here [file dirname [file normalize [info script]]]
set env(TERM) xterm-256color
spawn zsh -dfi
# Declared after spawn so it binds to the shell; before spawn it bound to stdin and timeouts never failed.
expect_after timeout {error "PTY assertion timed out"}
expect "%"
send -- "PS1='PROOF>'; setopt nounset ksharrays; bindkey -e; APPLE_FM_COMMAND='$here/fixture-fm'; APPLE_FM_DEBOUNCE=0.1; source '$here/apple-fm.zsh'\r"
expect "PROOF>"
send -- {saved=$(bindkey -M emacs '^I'; bindkey -M emacs '^['; bindkey -M emacs '^X^F'); function proof-buffer { zle -M -- "STATE:<${BUFFER}>:<${_APPLE_FM_SUGGESTION}>:<${_APPLE_FM_LAST_OUTCOME}>" }; zle -N proof-buffer; bindkey -M emacs '^X^B' proof-buffer; apple-fm-enable; print SETUP_DONE}
send -- "\r"
expect "\r\nSETUP_DONE\r\n"
expect "PROOF>"
send -- "alpha"
send -- "\030\006"
expect " suffix"
send -- "\030\002"
expect "STATE:<alpha>:< suffix>"
send -- "\t"
send -- "\030\002"
expect "STATE:<alpha suffix>:<>"
send -- "\003"
expect "PROOF>"
# Automatic suggestion after the debounce, with no explicit trigger.
send -- "auto"
after 800
send -- "\030\002"
expect "STATE:<auto>:< suffix>:<ok>"
send -- "\003"
expect "PROOF>"
# A two-line reply is rejected, and a failing CLI is reported with its exit code.
send -- "MULTI"
send -- "\030\006"
after 500
send -- "\030\002"
expect "STATE:<MULTI>:<>:<unsafe>"
send -- "\003"
expect "PROOF>"
send -- "FAIL"
send -- "\030\006"
after 500
send -- "\030\002"
expect "STATE:<FAIL>:<>:<exit:3>"
send -- "\003"
expect "PROOF>"
# A reply that doesn't restate the typed text is dropped.
send -- "OTHER"
send -- "\030\006"
after 500
send -- "\030\002"
expect "STATE:<OTHER>:<>:<mismatch>"
send -- "\003"
expect "PROOF>"
send -- "SLOW"
send -- "\030\006"
after 100
send -- "\033"
after 1500
send -- "\030\002"
expect "STATE:<SLOW>:<>"
send -- "\003"
expect "PROOF>"
send -- {sleep 60 & bg=$!; print BG_STARTED}
send -- "\r"
expect "\r\nBG_STARTED\r\n"
expect "PROOF>"
send -- "HANG"
send -- "\030\006"
after 200
send -- "\033"
after 200
# Clear with Ctrl-U, not Ctrl-C, which would interrupt the request itself and hide whether cancellation stopped it.
send -- "\025"
# Results are built from variables so the echoed command line cannot match the expected text.
send -- {fm=gone; pgrep -f "$APPLE_FM_COMMAND" >/dev/null && fm=running; bg_state=alive; kill -0 $bg 2>/dev/null || bg_state=killed; kill $bg 2>/dev/null; print "CANCEL:fm=$fm:bg=$bg_state:END"}
send -- "\r"
expect "CANCEL:fm=gone:bg=alive:END"
expect "PROOF>"
send -- {apple-fm-disable; [[ "$saved" == "$(bindkey -M emacs '^I'; bindkey -M emacs '^['; bindkey -M emacs '^X^F')" ]] && print RESTORED; print -u2 STDERR_ALIVE}
send -- "\r"
expect "\r\nRESTORED\r\n"
expect "STDERR_ALIVE"
expect "PROOF>"
send -- "exit\r"
expect eof
puts "PASS: preview, whitespace, Tab buffer insertion without execution, automatic suggestion, unsafe, failed and mismatched replies, dismissal, cancellation stops the model and spares background jobs, binding restoration, stderr preservation"
