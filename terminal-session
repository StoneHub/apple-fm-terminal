"""Apple FM Terminal session capture. Model generation uses the shared AppleFM Swift library."""
import argparse
import collections
import fcntl
import json
import os
from pathlib import Path
import platform
import pty
import re
import secrets
import select
import shlex
import shutil
import signal
import socket
import subprocess
import sys
