#!/bin/sh
set -eu
# Follow the installer-owned CLI symlink without requiring Python or readlink -f.
program=$0
while [ -L "$program" ]; do
  parent=$(CDPATH= cd -- "$(dirname -- "$program")" && pwd)
  program=$(readlink "$program")
  case "$program" in /*) ;; *) program="$parent/$program";; esac
done
root=$(CDPATH= cd -- "$(dirname -- "$program")" && pwd)
exec "$root/runtime/bin/python3" -I -B "$root/scripts/management.py" "$@"
